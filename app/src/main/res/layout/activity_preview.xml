<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".PreviewActivity">

    <!-- Native 3D Filament Renderer Container -->
    <FrameLayout
        android:id="@+id/fl_renderer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Container avoiding obstruction -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:fitsSystemWindows="true">

        <!-- Top Layer Slicer Control Bar (Shulkr Style) positioned to the left of the actions -->
        <LinearLayout
            android:id="@+id/ll_layer_slicer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/ll_actions_toolbar"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_glassmorphic_panel"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_layer_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="Layer: 0 / 0" />

                <TextView
                    android:id="@+id/tv_loading_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:text="@string/loading" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_layer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:stepSize="1.0"
                android:value="100.0"
                app:thumbColor="#38BDF8"
                app:thumbRadius="6dp"
                app:trackHeight="3dp"
                app:trackColorActive="#38BDF8"
                app:trackColorInactive="#262626" />
        </LinearLayout>

        <!-- Top Right Glassmorphic Actions Toolbar (Shulkr Style, reduced 1/3 to 28dp) -->
        <LinearLayout
            android:id="@+id/ll_actions_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="vertical"
            android:elevation="6dp">

            <!-- Camera Mode (Orbit / Flight) -->
            <ImageButton
                android:id="@+id/btn_camera_mode"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="8dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_glassmorphic_btn"
                android:contentDescription="@string/view_flight"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="#38BDF8" />

            <!-- Projection Mode (Perspective / Orthographic) -->
            <ImageButton
                android:id="@+id/btn_projection_mode"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="8dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_glassmorphic_btn"
                android:contentDescription="@string/view_projection"
                android:src="@android:drawable/ic_menu_view"
                app:tint="#60A5FA" />

            <!-- Reset Camera -->
            <ImageButton
                android:id="@+id/btn_reset_camera"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="8dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_glassmorphic_btn"
                android:contentDescription="@string/view_reset"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FBBF24" />

            <!-- Day / Night Mode -->
            <ImageButton
                android:id="@+id/btn_day_night"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="8dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_glassmorphic_btn"
                android:contentDescription="@string/view_day_night"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="#FB923C" />

            <!-- Subregion Switch -->
            <ImageButton
                android:id="@+id/btn_region_switch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_glassmorphic_btn"
                android:contentDescription="@string/view_region"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="#4ADE80" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Draggable Bottom Sheet Layer for block counts -->
    <include
        android:id="@+id/bottom_sheet_root"
        layout="@layout/bottom_sheet_statistics" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
