<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solarized_base03"
    tools:context=".PreviewActivity">

    <!-- Native 3D Filament Renderer Container -->
    <FrameLayout
        android:id="@+id/fl_renderer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/solarized_base03" />

    <!-- Top Layer Slicer Control Bar (Shulkr Style) -->
    <LinearLayout
        android:id="@+id/ll_layer_slicer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glassmorphic_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="4dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_layer_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/solarized_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Layer: 0 / 0" />

            <TextView
                android:id="@+id/tv_loading_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/solarized_yellow"
                android:textSize="12sp"
                android:visibility="gone"
                android:text="@string/loading" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_layer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="100.0"
            android:stepSize="1.0"
            android:value="100.0"
            app:thumbColor="@color/solarized_cyan"
            app:trackColorActive="@color/solarized_cyan"
            app:trackColorInactive="@color/solarized_base02" />
    </LinearLayout>

    <!-- Top Right Glassmorphic Actions Toolbar (Shulkr Style) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:elevation="6dp">

        <!-- Camera Mode (Orbit / Flight) -->
        <ImageButton
            android:id="@+id/btn_camera_mode"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glassmorphic_btn"
            android:contentDescription="@string/view_flight"
            android:src="@android:drawable/ic_menu_directions"
            app:tint="@color/solarized_cyan" />

        <!-- Projection Mode (Perspective / Orthographic) -->
        <ImageButton
            android:id="@+id/btn_projection_mode"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glassmorphic_btn"
            android:contentDescription="@string/view_projection"
            android:src="@android:drawable/ic_menu_view"
            app:tint="@color/solarized_blue" />

        <!-- Reset Camera -->
        <ImageButton
            android:id="@+id/btn_reset_camera"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glassmorphic_btn"
            android:contentDescription="@string/view_reset"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/solarized_yellow" />

        <!-- Day / Night Mode -->
        <ImageButton
            android:id="@+id/btn_day_night"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glassmorphic_btn"
            android:contentDescription="@string/view_day_night"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="@color/solarized_orange" />

        <!-- Subregion Switch -->
        <ImageButton
            android:id="@+id/btn_region_switch"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_glassmorphic_btn"
            android:contentDescription="@string/view_region"
            android:src="@android:drawable/ic_dialog_map"
            app:tint="@color/solarized_green" />

    </LinearLayout>

    <!-- Draggable Bottom Sheet Layer for block counts -->
    <include
        android:id="@+id/bottom_sheet_root"
        layout="@layout/bottom_sheet_statistics" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
